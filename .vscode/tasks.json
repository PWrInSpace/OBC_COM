{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Format Code",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build", "build/Debug", "--target", "format"
            ],
            "problemMatcher": []
        },
        {
            "label": "Build",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build", "build/Debug"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "dependsOn": ["Format Code"],
            "problemMatcher": ["$gcc"]
        },
        {
            "label": "Flash DFU",
            "type": "shell",
            "command": "STM32_Programmer_CLI",
            "windows": {
                "command": "C:/Program Files/STMicroelectronics/STM32Cube/STM32CubeProgrammer/bin/STM32_Programmer_CLI.exe"
            },
            "args": [
                "-c", "port=usb1",
                "-w", "${workspaceFolder}/build/Debug/OBC_COM.bin", "0x08000000",
                "-v",
                "-s"
            ],
            "linux": {
                "args": [
                    "-c", "port=usb1",
                    "-w", "${workspaceFolder}/build/Debug/OBC_COM.bin", "0x08000000",
                    "-v",
                    "-s"
                ]
            },
            "group": {
                "kind": "test",
                "isDefault": true
            },
            "problemMatcher": []
        }
    ]
}